{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-guard.sh",
            "timeout": 15,
            "statusMessage": "devflow-guard 執行守衛"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/history-guard.sh",
            "timeout": 15,
            "statusMessage": "history-guard 單一寫入口"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-prebash.sh",
            "timeout": 15,
            "statusMessage": "devflow-guard shell 圍欄"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-dispatch-guard.sh",
            "timeout": 15,
            "statusMessage": "devflow-guard 派工分層守衛"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devtalk-guard.sh",
            "timeout": 15,
            "statusMessage": "devtalk-guard 盲檢"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-report-guard.sh",
            "timeout": 15,
            "statusMessage": "report-guard 去識別化"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-postbash.sh",
            "timeout": 15,
            "statusMessage": "devflow-guard 偵測網"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-stop-selftest.sh",
            "timeout": 600,
            "statusMessage": "devflow 守衛自測(改完才跑、通過後 6 小時內不重跑)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-plainspeak.sh",
            "timeout": 5,
            "statusMessage": "plainspeak 白話回覆提醒"
          }
        ]
      }
    ]
  }
}
